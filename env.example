# .env.example のテンプレート本文(.env.example を作れない環境向けの控え)。
# 使い方: cp env.example data/private/.env して GOOGLE_CLOUD_PROJECT に実値を入れる(data/private/ は git 管理外)
GOOGLE_CLOUD_PROJECT=
GENMEDIA_LOCATION=global
MODEL_IMAGE=gemini-nano-banana-2.1
MODEL_VIDEO=gemini-omni-1.2-flash
MODEL_MUSIC=lyria-3-pro-preview
MODEL_TTS=gemini-3.8-flash-tts
PORT=8080
